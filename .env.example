# GigaChat API Configuration
GIGACHAT_API_KEY=your_api_key_here
GIGACHAT_MODEL=GigaChat

# Service Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
DEBUG=False


# LLM Configuration
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0

# Cache Configuration
CACHE_TTL_SECONDS=600

# Request Limits
MAX_REQUEST_LENGTH=10000
